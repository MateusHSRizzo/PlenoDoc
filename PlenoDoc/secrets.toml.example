# ============================================================
# secrets.toml — Cole este conteúdo no painel do Streamlit Cloud
# App Settings → Secrets
# ============================================================

# ── Chaves de API LLM ─────────────────────────────────────────
OPENAI_API_KEY = "sk-..."
GROQ_API_KEY   = "gsk_..."

# ── Usuários do sistema ───────────────────────────────────────
# Formato: username = "senha_em_texto_puro"
# O PlenoDoc faz o hash internamente na primeira leitura.
# IMPORTANTE: defina aqui para não perder o acesso no reboot.
[usuarios]
Administrador = "sua_senha_aqui"
# Operador      = "outra_senha"

# ── Configurações opcionais ───────────────────────────────────
SESSION_TIMEOUT_MINUTES  = "60"
MAX_REQUESTS_PER_MINUTE  = "20"
ENABLE_RERANKING         = "true"
ENABLE_HYBRID_SEARCH     = "true"
ENABLE_LLM_CACHE         = "true"
ENABLE_AUTO_SUMMARY      = "true"
ENABLE_SUGGESTIONS       = "true"
